{
  "name": "kortex",
  "version": "1.1.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.kortex.launcher",
    "productName": "KortexLauncher",
    "publish": [
      {
        "provider": "github",
        "owner": "minzustudio",
        "repo": "krtxlnchr"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "./sources/kortexlogo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "**/*",
      "!games/**/*",
      "!play.js",
      "!test.js",
      "!test3.js",
      "!getSrc.js",
      "!checker.js",
      "!data.json",
      "!games.json",
      "!update.bat"
    ]
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "electron-updater": "^6.8.9",
    "got-scraping": "^4.2.1",
    "node-unrar-js": "^2.0.2",
    "puppeteer": "^25.10.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2"
  }
}
